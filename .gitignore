# dependencies
node_modules/
.pnp
.pnp.js

# next
/.next/
/out/
next-env.d.ts

# cloudflare / opennext
/.open-next/
.wrangler/
cloudflare-env.d.ts

# production
/build

# env — NEVER commit real secrets
.env
.env*.local
.env.local
.env.production

# Credential files that arrive as downloads and get dropped in the repo by
# accident. A Google service-account key is a JSON file called something like
# neyora-123456-abcdef.json; it belongs in a password manager, never here.
*-credentials.env
service-account*.json
*-service-account*.json
gcp-*.json
*.pem
*.p12

# misc
.DS_Store
*.pem
.vscode/
.idea/
coverage/
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# wrangler local vars
.dev.vars

# Vercel CLI link state. Holds the project and org id — not a secret, but
# machine-specific and no use to anyone else.
.vercel

# Added by the Vercel CLI. Broader than the rules above and harmless, but it is
# the one that catches a .env variant nobody thought to name.
.env*
