/**
 * Cloudflare Workers configuration for NEYORA.
 *
 * This is the CURRENT supported way to run Next.js on Cloudflare: the app is
 * adapted by @opennextjs/cloudflare and deployed as a Worker with static
 * assets. It is NOT the legacy `@cloudflare/next-on-pages` / Pages flow.
 *
 * Deploy:
 *   npm run cf:build     # adapt the Next.js build for Workers
 *   npm run cf:preview   # run it locally in workerd (needs Node >= 22)
 *   npm run cf:deploy    # push it live
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neyora",
  "main": ".open-next/worker.js",

  // Pin this. Workers behaviour is versioned by date, and an unpinned date
  // means a future runtime change could alter behaviour without a code change.
  "compatibility_date": "2026-09-01",

  // nodejs_compat is required: Next.js server code uses Node built-ins
  // (streams, crypto, buffer) that the base Workers runtime does not provide.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Public values only. Secrets are set with `wrangler secret put NAME`, or in
  // the Cloudflare dashboard — never committed here.
  "vars": {
    "NEXT_PUBLIC_ANALYTICS_PROVIDER": "internal",
    "NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET": "media"
  }

  // --- Optional: full ISR/caching support -----------------------------------
  // Without a cache binding, pages marked `revalidate` are rendered per
  // request. That is correct and works fine; it is simply not cached between
  // requests. To enable real incremental caching, create an R2 bucket and
  // uncomment both this binding and the matching incrementalCache line in
  // open-next.config.ts. R2 has a free tier, but it is a quota, not "free
  // forever" — watch your usage.
  //
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "neyora-cache" }
  // ]
}
