/**
 * Cloudflare Workers configuration for NEYORA.
 *
 * This is the CURRENT supported way to run Next.js on Cloudflare: the app is
 * adapted by @opennextjs/cloudflare and deployed as a Worker with static
 * assets. It is NOT the legacy `@cloudflare/next-on-pages` / Pages flow.
 *
 * Deploy:
 *   npm run cf:build     # adapt the Next.js build for Workers
 *   npm run cf:preview   # run it locally in workerd
 *   npm run cf:deploy    # push it live
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neyora",
  "main": ".open-next/worker.js",

  // Pin this. Workers behaviour is versioned by date, and an unpinned date
  // means a future runtime change could alter behaviour without a code change.
  "compatibility_date": "2026-09-01",

  // nodejs_compat is required: Next.js server code uses Node built-ins that
  // the base Workers runtime does not provide.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  /*
   * Public values only — there are no secrets in this project.
   *
   * NEYORA_QR_DESTINATION is the one worth knowing about: change it here or
   * in the Cloudflare dashboard and every QR code already printed on your
   * packaging points somewhere new, with no redeploy and no reprinting.
   * Leave it unset to use `qr.destination` from content/site.yml.
   */
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://neyora.com",
    "NEXT_PUBLIC_ANALYTICS_PROVIDER": "none"
    // "NEYORA_QR_DESTINATION": "/recipes"
  }
}
