# ============================================================================
# NEYORA — environment variables
#
#   cp .env.example .env.local
#
# There are no secrets here. The site has no database and no credentials: all
# content lives in /content and all images in /public. Everything below is
# optional except the site URL.
# ============================================================================


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# image URLs, sitemap.xml and robots.txt.
#
# Local: http://localhost:3000    Production: https://neyora.com
#
# Set this before you BUILD, not just before you run — pages are prerendered.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# The packaging QR code (optional)
# ---------------------------------------------------------------------------
# Where /go sends people. Overrides the `qr.destination` value in
# content/site.yml when set.
#
# This is the one setting worth putting in the environment rather than the
# repository: on Cloudflare it is a Worker variable, so you can change where
# every printed label leads from the dashboard in seconds — no redeploy, no
# database, and no reprinting.
#
# Must be a path on this site, e.g. /recipes
NEYORA_QR_DESTINATION=


# ---------------------------------------------------------------------------
# Analytics (optional, privacy-friendly only)
# ---------------------------------------------------------------------------
# none      — collect nothing (default)
# umami     — self-hosted or free-tier Umami
# plausible — self-hosted Plausible
#
# No third-party JavaScript ships unless you set one of these.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=


# ---------------------------------------------------------------------------
# Search-engine verification (optional — leave blank to omit the meta tag)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ===========================================================================
# ORDERS — database
# ===========================================================================
# A SECRET. Never commit a filled-in value, never prefix it NEXT_PUBLIC_.
# On Cloudflare set it with `npx wrangler secret put MONGODB_URI`, NOT in
# wrangler.jsonc — that file is committed.
#
# Without it the site still builds and serves; only ordering and the admin
# are unavailable.
MONGODB_URI=
# Optional. Defaults to "neyora".
MONGODB_DB=


# ===========================================================================
# ADMIN NOTIFICATIONS
# ===========================================================================
# Email is the only channel today. WhatsApp is the intended second one.
#
# Every channel is INDEPENDENTLY OPTIONAL. A channel with no credentials is
# disabled, not broken: orders still save, and the admin dashboard shows that
# channel as "Not set up" rather than failed. That is what lets you run the
# whole order flow locally without any provider account.
#
# All of these are SECRETS. None is NEXT_PUBLIC_*, and none may ever be.

# ---------------------------------------------------------------------------
# Email via Resend (free tier: 3,000/month, 100/day)
# ---------------------------------------------------------------------------
# 1. Create a Resend account and add neyora.com as a domain.
# 2. Add the DKIM/SPF DNS records Resend gives you, and wait for "Verified".
# 3. Create an API key with Sending access only.
#
# ORDER_EMAIL_FROM must be on the verified domain, e.g.
#   NEYORA Orders <orders@neyora.com>
# ADMIN_NOTIFICATION_EMAIL may be a comma-separated list.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Google Sheets — reporting projection (optional)
# ---------------------------------------------------------------------------
# MongoDB is the source of truth for every order. This spreadsheet is a
# ONE-WAY, read-only-for-humans projection for reporting. Nothing is ever read
# back from it, and the site works completely without it.
#
# Setup:
#   1. Google Cloud Console -> create (or pick) a project.
#   2. APIs & Services -> Library -> enable "Google Sheets API".
#   3. IAM & Admin -> Service Accounts -> Create. No project roles are needed:
#      access comes from sharing the sheet, not from IAM.
#   4. On that service account -> Keys -> Add key -> Create new key -> JSON.
#   5. From the JSON file, copy `client_email` and `private_key` below.
#   6. Create a Google Sheet. Share it with the client_email as EDITOR.
#   7. The spreadsheet id is the long id in its URL:
#      docs.google.com/spreadsheets/d/<THIS PART>/edit
#
# GOOGLE_PRIVATE_KEY is multi-line. Keep the \n sequences exactly as they
# appear in the JSON and wrap the whole value in double quotes:
#   GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The tab name. Defaults to "Orders"; it is created with its header row on
# first sync, so you do not need to make it by hand.
GOOGLE_SHEETS_TAB=


# ---------------------------------------------------------------------------
# Retry sweep endpoint (optional)
# ---------------------------------------------------------------------------
# A shared secret for POST /api/sync/retry, which re-sends any admin alert that
# never landed and re-syncs any spreadsheet row that fell behind. Both are
# idempotent: an alert already sent is not re-sent, and a sheet row is upserted
# rather than appended. Leave it BLANK and the route returns 404 — it does not
# exist until you configure it.
#
# Point any scheduler at it:
#   curl -X POST https://neyora.com/api/sync/retry \
#        -H "Authorization: Bearer $SYNC_RETRY_SECRET"
#
# Generate one with:  openssl rand -hex 32
SYNC_RETRY_SECRET=


# ---------------------------------------------------------------------------
# Farm production tracking (optional)
# ---------------------------------------------------------------------------
# A SEPARATE Google spreadsheet from the Orders one. For farm data, Sheets is
# the SOURCE OF TRUTH — nothing is copied into MongoDB — so this workbook is
# the record, not a projection.
#
# Setup:
#   1. Create a new Google Sheet, e.g. "NEYORA Farm".
#   2. Share it with the same service account as an EDITOR
#      (GOOGLE_SERVICE_ACCOUNT_EMAIL above).
#   3. Put its id here — the long id in the URL between /d/ and /edit.
#
# Do NOT create the tabs by hand. Batches, Bags, Harvests, Contamination,
# Costs and Sales are created with their headers and formatting on first use.
#
# It must NOT be the same document as GOOGLE_SHEETS_ID; the app refuses to run
# if it is, rather than writing farm tabs into the orders workbook.
FARM_GOOGLE_SHEETS_ID=
