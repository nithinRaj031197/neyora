# ============================================================================
# NEYORA — environment variables
# ============================================================================
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local. NEVER put a service-role key in a NEXT_PUBLIC_* var.
# ============================================================================


# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Data API
# Example: https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe in the browser: every request it makes is
# constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# Supabase — SECRET (server only)
# ---------------------------------------------------------------------------
# The service-role key BYPASSES Row Level Security. It is read only from
# server-side code (`lib/supabase/admin.ts`, which throws if imported into a
# client bundle). Never prefix it with NEXT_PUBLIC_.
#
# Used for: the one-time admin bootstrap, storage housekeeping, and QR scan
# logging (an anonymous insert that must not be writable by the public).
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# image URLs, sitemap.xml and robots.txt.
# Local: http://localhost:3000    Production: https://neyora.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# First-admin bootstrap (one-time)
# ---------------------------------------------------------------------------
# A long random string of your choosing. Visit /admin/setup while signed in and
# paste this value to promote your own account to owner.
#
# The bootstrap refuses to run once ANY admin exists, so this is not a backdoor.
# Generate one with:  openssl rand -hex 32
# Delete this variable from your host once setup is complete.
ADMIN_SETUP_TOKEN=


# ---------------------------------------------------------------------------
# Analytics (optional, free-tier friendly)
# ---------------------------------------------------------------------------
# Which analytics provider the abstraction in `lib/analytics` should use:
#   none      — collect nothing (default)
#   internal  — store aggregate events in your own Postgres (analytics_events)
#   umami     — self-hosted / free-tier Umami
#   plausible — self-hosted Plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=internal

# Only needed for umami / plausible.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Public Supabase Storage bucket that holds the media library.
# Created by migration 0004_storage.sql — change only if you renamed it.
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media


# ---------------------------------------------------------------------------
# Search-engine verification (optional — leave blank to omit the meta tags)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
