# ============================================================================
# NEYORA — environment variables
#
#   cp .env.example .env.local
#
# There are no secrets here. The site has no database and no credentials: all
# content lives in /content and all images in /public. Everything below is
# optional except the site URL.
# ============================================================================


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph
# image URLs, sitemap.xml and robots.txt.
#
# Local: http://localhost:3000    Production: https://neyora.com
#
# Set this before you BUILD, not just before you run — pages are prerendered.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# The packaging QR code (optional)
# ---------------------------------------------------------------------------
# Where /go sends people. Overrides the `qr.destination` value in
# content/site.yml when set.
#
# This is the one setting worth putting in the environment rather than the
# repository: on Cloudflare it is a Worker variable, so you can change where
# every printed label leads from the dashboard in seconds — no redeploy, no
# database, and no reprinting.
#
# Must be a path on this site, e.g. /recipes
NEYORA_QR_DESTINATION=


# ---------------------------------------------------------------------------
# Analytics (optional, privacy-friendly only)
# ---------------------------------------------------------------------------
# none      — collect nothing (default)
# umami     — self-hosted or free-tier Umami
# plausible — self-hosted Plausible
#
# No third-party JavaScript ships unless you set one of these.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=


# ---------------------------------------------------------------------------
# Search-engine verification (optional — leave blank to omit the meta tag)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
